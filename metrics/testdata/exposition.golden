# HELP backup_last_success_timestamp Unix time of the last successful backup.
# TYPE backup_last_success_timestamp gauge
backup_last_success_timestamp 10
# HELP cache_bytes Image cache size.
# TYPE cache_bytes gauge
cache_bytes 1024
# HELP database_bytes SQLite file size.
# TYPE database_bytes gauge
database_bytes 4096
# HELP http_request_duration_seconds HTTP request latency.
# TYPE http_request_duration_seconds histogram
http_request_duration_seconds_bucket{route="/login",le="0.005"} 0
http_request_duration_seconds_bucket{route="/login",le="0.01"} 0
http_request_duration_seconds_bucket{route="/login",le="0.025"} 1
http_request_duration_seconds_bucket{route="/login",le="0.05"} 1
http_request_duration_seconds_bucket{route="/login",le="0.1"} 1
http_request_duration_seconds_bucket{route="/login",le="0.25"} 1
http_request_duration_seconds_bucket{route="/login",le="0.5"} 1
http_request_duration_seconds_bucket{route="/login",le="1"} 1
http_request_duration_seconds_bucket{route="/login",le="2.5"} 1
http_request_duration_seconds_bucket{route="/login",le="5"} 1
http_request_duration_seconds_bucket{route="/login",le="+Inf"} 1
http_request_duration_seconds_sum{route="/login"} 0.02
http_request_duration_seconds_count{route="/login"} 1
# HELP http_requests_total HTTP requests.
# TYPE http_requests_total counter
http_requests_total{route="/login",status="200"} 2
# HELP outbound_requests_total Outbound requests.
# TYPE outbound_requests_total counter
outbound_requests_total{host_class="api",status="200"} 4
# HELP paused_hosts Hosts currently paused.
# TYPE paused_hosts gauge
paused_hosts 0
# HELP sync_freshness_seconds Age of the last good sync.
# TYPE sync_freshness_seconds gauge
sync_freshness_seconds{account="1"} 30
# HELP sync_runs_total Sync runs.
# TYPE sync_runs_total counter
sync_runs_total{service="livejournal",result="ok"} 1
